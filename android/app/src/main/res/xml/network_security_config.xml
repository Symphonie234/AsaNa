<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows plain HTTP only to the emulator's loopback to the host machine,
    where the local Laravel dev server runs. Production must use HTTPS
    against the real API domain — do not widen this for release builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
